{
  "name": "zk-scribe",
  "version": "0.3.0",
  "description": "Cryptographic authorship and contribution attestation for academic writing.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zk-scribe": "bin/zk-scribe.js"
  },
  "files": [
    "bin",
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "zk-scribe": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian-mwirigi/ZK-Scribe.git"
  },
  "homepage": "https://brianmunene.me/zkscribe",
  "bugs": {
    "url": "https://github.com/brian-mwirigi/ZK-Scribe/issues"
  }
}
